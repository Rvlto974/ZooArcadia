<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Zoo Arcadia{% endblock %}</title>

    <link rel="stylesheet" href="{{ asset('css/style.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body>
    <header>
        <nav class="navbar">
            <a href="{{ path('app_home') }}" class="logo">
                Zoo Arcadia
            </a>

            <ul class="nav-links">
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="{{ path('app_home') }}#presentation">Présentation</a></li>
                <li><a href="{{ path('app_home') }}#habitats">Habitats</a></li>
                <li><a href="{{ path('app_home') }}#services">Services</a></li>
                <li><a href="{{ path('app_home') }}#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="footer">
        <p>&copy; {{ "now"|date("Y") }} Zoo Arcadia</p>
    </footer>

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}


</body>
</html>