{% extends 'base.html.twig' %}

{% block title %}Accueil - Zoo Arcadia{% endblock %}

{% block body %}

    {# Section principale d'accueil #}
    <section class="hero">
        <div class="hero-content">
            <h1>Bienvenue au Zoo Arcadia</h1>

            <p>
                Découvrez nos animaux, nos habitats naturels
                et nos actions pour protéger la biodiversité.
            </p>

            <a href="#presentation" class="btn-primary">
                Découvrir le zoo
            </a>
        </div>
    </section>

    {# Présentation du zoo #}
    <section id="presentation" class="presentation">
        <h2>Présentation du zoo</h2>

        <p>
            Le Zoo Arcadia accueille de nombreuses espèces animales
            dans des environnements adaptés à leurs besoins.
        </p>
    </section>

    {# Section des habitats #}
    <section id="habitats" class="habitats">
        <h2>Nos habitats</h2>

        <div class="card-container">
            <article class="card">
                <h3>La savane</h3>
                <p>
                    Découvrez les lions, les girafes et les éléphants.
                </p>
            </article>

            <article class="card">
                <h3>La jungle</h3>
                <p>
                    Observez les singes, les perroquets et les félins.
                </p>
            </article>

            <article class="card">
                <h3>La zone aquatique</h3>
                <p>
                    Explorez l'univers des crocodiles, tortues et poissons.
                </p>
            </article>
        </div>
    </section>

    {# Section des services #}
    <section id="services" class="services">
        <h2>Nos services</h2>

        <div class="card-container">
            <article class="card">
                <h3>Visites guidées</h3>
                <p>
                    Profitez d'une visite accompagnée par notre équipe.
                </p>
            </article>

            <article class="card">
                <h3>Restauration</h3>
                <p>
                    Faites une pause dans nos espaces de restauration.
                </p>
            </article>

            <article class="card">
                <h3>Boutique</h3>
                <p>
                    Retrouvez des souvenirs du Zoo Arcadia.
                </p>
            </article>
        </div>
    </section>

{% endblock %}