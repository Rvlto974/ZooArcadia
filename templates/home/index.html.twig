<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Zoo Nature</title>

    {# Lien vers le fichier CSS #}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>

<body>

    {# =========================
       Barre de navigation
    ========================== #}
    <header class="navbar">

        {# Logo du site #}
        <a href="{{ path('app_home') }}" class="logo">
            Zoo Nature
        </a>

        {# Liens de navigation #}
        <nav>
            <ul class="nav-links">
                <li><a href="#presentation">Présentation</a></li>
                <li><a href="#habitats">Habitats</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>

    </header>


    <main>

        {# =========================
           Section principale
        ========================== #}
        <section class="hero">

            <div class="hero-content">
                <h1>Bienvenue au Zoo Nature</h1>

                <p>
                    Découvrez un espace dédié aux animaux,
                    à la nature et à la protection de la biodiversité.
                </p>

                {# Bouton utilisé par JavaScript #}
                <button id="toggle-habitats" class="btn-primary">
                    Afficher les habitats
                </button>
            </div>

        </section>


        {# =========================
           Section présentation
        ========================== #}
        <section id="presentation" class="presentation">

            <h2>Présentation du zoo</h2>

            <p>
                Notre zoo accueille de nombreuses espèces animales
                dans des environnements adaptés à leurs besoins.
            </p>

            <p>
                Notre objectif est de sensibiliser les visiteurs
                à la protection des animaux et de leur environnement.
            </p>

        </section>


        {# =========================
           Section habitats
        ========================== #}
        <section id="habitats" class="habitats">

            <h2>Nos habitats</h2>

            {# Cette liste est cachée au départ grâce à la classe cache #}
            <div id="liste-habitats" class="card-container cache">

                {# Première carte #}
                <article class="card">
                    <h3>La savane</h3>

                    <p>
                        Découvrez les lions, les girafes,
                        les éléphants et les zèbres.
                    </p>
                </article>

                {# Deuxième carte #}
                <article class="card">
                    <h3>La jungle</h3>

                    <p>
                        Observez les singes, les perroquets
                        et les animaux vivant dans les forêts tropicales.
                    </p>
                </article>

                {# Troisième carte #}
                <article class="card">
                    <h3>Le monde marin</h3>

                    <p>
                        Explorez l'univers des poissons,
                        des tortues et des animaux marins.
                    </p>
                </article>

            </div>

        </section>


        {# =========================
           Section services
        ========================== #}
        <section id="services" class="services">

            <h2>Nos services</h2>

            <div class="card-container">

                <article class="card">
                    <h3>Visites guidées</h3>

                    <p>
                        Participez à une visite accompagnée
                        par un professionnel.
                    </p>
                </article>

                <article class="card">
                    <h3>Espace restauration</h3>

                    <p>
                        Profitez d'un espace pour vous restaurer
                        pendant votre visite.
                    </p>
                </article>

                <article class="card">
                    <h3>Boutique</h3>

                    <p>
                        Retrouvez des souvenirs et des produits
                        liés à la protection des animaux.
                    </p>
                </article>

            </div>

        </section>

    </main>


    {# =========================
       Pied de page
    ========================== #}
    <footer id="contact" class="footer">

        <div class="footer-content">

            <div class="footer-column">
                <h3>Zoo Nature</h3>

                <p>
                    Un lieu de découverte et de protection
                    de la biodiversité.
                </p>
            </div>

            <div class="footer-column">
                <h3>Contact</h3>

                <p>Email : contact@zoonature.fr</p>
                <p>Téléphone : 02 62 00 00 00</p>
            </div>

            <div class="footer-column">
                <h3>Adresse</h3>

                <p>12 rue de la Nature</p>
                <p>La Réunion</p>
            </div>

        </div>

        <p class="footer-bottom">
            &copy; {{ "now"|date("Y") }} Zoo Nature - Tous droits réservés
        </p>

    </footer>


    {# Fichier JavaScript principal #}
    <script src="{{ asset('js/script.js') }}"></script>

</body>
</html>