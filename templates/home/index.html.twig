{% extends 'base.html.twig' %}

{% block title %}Accueil - Zoo Arcadia{% endblock %}

{% block body %}

<section class="hero">
    <div class="hero-content">
        <h1>Bienvenue au Zoo Arcadia</h1>

        <p>
            Découvrez nos animaux, leurs habitats naturels
            et nos actions pour protéger la biodiversité.
        </p>

        <a href="#presentation" class="btn-primary">
            Découvrir le zoo
        </a>
    </div>
</section>

<section id="presentation" class="presentation">
    <h2>Présentation du zoo</h2>

    <p>
        Le Zoo Arcadia accueille de nombreuses espèces animales
        dans des environnements adaptés à leurs besoins.
    </p>
</section>

<section id="habitats" class="habitats">
    <h2>Nos habitats</h2>

    <div class="card-container">
        <article class="card habitat-card">
            <h3>La jungle</h3>
            <p>
                Découvrez un espace riche en végétation
                et observez ses animaux fascinants.
            </p>
        </article>

        <article class="card habitat-card">
            <h3>La savane</h3>
            <p>
                Observez les animaux des grandes plaines
                africaines.
            </p>
        </article>

        <article class="card habitat-card">
            <h3>Le marais</h3>
            <p>
                Explorez les milieux humides et leurs espèces
                particulières.
            </p>
        </article>
    </div>
</section>

<section id="services" class="services">
    <h2>Nos services</h2>

    <div class="card-container">
        <article class="card">
            <h3>Restauration</h3>
            <p>
                Profitez d'une pause repas dans un cadre naturel.
            </p>
        </article>

        <article class="card">
            <h3>Accessibilité</h3>
            <p>
                Le zoo est accessible à tous les visiteurs.
            </p>
        </article>

        <article class="card">
            <h3>Visites guidées</h3>
            <p>
                Découvrez les animaux accompagnés par nos équipes.
            </p>
        </article>
    </div>
</section>

<section id="contact" class="contact">
    <h2>Contactez-nous</h2>

    <p>
        Une question ? L'équipe du Zoo Arcadia est à votre écoute.
    </p>

    <p>
        Téléphone : 0262 00 00 00
    </p>

    <p>
        Email : contact@zoo-arcadia.fr
    </p>
</section>

{% endblock %}