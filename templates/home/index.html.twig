{% extends 'base.html.twig' %}

{% block title %}Accueil - Zoo Arcadia{% endblock %}

{% block body %}

    {# Section principale d'accueil #}
    <section class="hero animation-scroll">
        <div class="hero-content">
            <h1>Bienvenue au Zoo Arcadia</h1>

            <p>
                Découvrez nos animaux, leurs habitats naturels
                et nos actions pour protéger la biodiversité.
            </p>

            <a href="#presentation" class="btn-primary">
                Découvrir le zoo
            </a>
        </div>
    </section>


    {# Présentation du zoo #}
    <section id="presentation" class="presentation animation-scroll">
        <h2>Présentation du zoo</h2>

        <p>
            Le Zoo Arcadia accueille de nombreuses espèces animales
            dans des environnements adaptés à leurs besoins.
        </p>
    </section>


    {# Section des habitats #}
    <section id="habitats" class="habitats animation-scroll">
        <h2>Nos habitats</h2>

        {# Bouton utilisé par le JavaScript #}
        <button id="toggle-habitats" class="btn-primary">
            Cacher les habitats
        </button>

        {# Liste des cartes d'habitats #}
        <div id="liste-habitats" class="card-container">

            {# Carte de la savane #}
            <article class="card animation-scroll">
                <h3>La savane</h3>

                <p>
                    Découvrez les lions, les girafes et les éléphants.
                </p>
            </article>

            {# Carte de la jungle #}
            <article class="card animation-scroll">
                <h3>La jungle</h3>

                <p>
                    Observez les singes, les perroquets et les félins.
                </p>
            </article>

            {# Carte du marais #}
            <article class="card animation-scroll">
                <h3>Le marais</h3>

                <p>
                    Observez les animaux vivant dans les milieux humides.
                </p>
            </article>

        </div>
    </section>


    {# Section des services #}
    <section class="services animation-scroll">
        <h2>Nos services</h2>

        <div class="card-container">

            <article class="card animation-scroll">
                <h3>Visites guidées</h3>

                <p>
                    Apprenez-en plus sur les animaux avec nos soigneurs.
                </p>
            </article>

            <article class="card animation-scroll">
                <h3>Restauration</h3>

                <p>
                    Profitez de nos espaces de restauration pendant votre visite.
                </p>
            </article>

            <article class="card animation-scroll">
                <h3>Boutique</h3>

                <p>
                    Retrouvez des souvenirs du Zoo Arcadia.
                </p>
            </article>

        </div>
    </section>

{% endblock %}