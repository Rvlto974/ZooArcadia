@startuml sequence_connexion

actor Utilisateur
participant "Frontend" as FE
participant "API Backend" as API
participant "Middleware Auth" as MW
database "Base MySQL" as DB

Utilisateur -> FE : Saisit email + mot de passe
FE -> API : POST /api/auth/login {email, motDePasse}

API -> DB : SELECT * FROM Utilisateur WHERE email = ?
DB --> API : Retourne utilisateur (ou vide)

alt Utilisateur non trouvé
    API --> FE : 401 Unauthorized
    FE --> Utilisateur : Affiche erreur "Identifiants invalides"
else Utilisateur trouvé
    API -> API : Compare motDePasse avec hash (bcrypt)
    alt Mot de passe incorrect
        API --> FE : 401 Unauthorized
        FE --> Utilisateur : Affiche erreur "Identifiants invalides"
    else Mot de passe correct
        API -> API : Génère token JWT (id, role)
        API --> FE : 200 OK {token, role}
        FE -> FE : Stocke le token (localStorage / cookie)
        FE --> Utilisateur : Redirige vers dashboard selon role
    end
end

note over MW : Le token JWT sera vérifié\npar ce middleware sur\nchaque requête protégée

@enduml